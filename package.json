{
  "name": "claude-converse",
  "version": "0.7.0",
  "type": "module",
  "description": "Shared TypeScript voice core with Claude and Pi adapters",
  "license": "MIT",
  "author": "Naftoli Gugenheim",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "pi-package"
  ],
  "files": [
    ".claude-plugin/*.json",
    "dist/",
    "hooks/hooks.json",
    "pi/index.js",
    "services/*.py",
    "skills/**/*.md",
    "skills/**/*.sh",
    "CHANGELOG.md",
    "CLAUDE.md",
    "LICENSE",
    "README.md",
    "config.example.conf"
  ],
  "bin": {
    "converse-claude-daemon": "./dist/claude/daemon.js",
    "converse-claude-speak-hook": "./dist/claude/speak-hook.js",
    "converse-claude-inject-session-id": "./dist/claude/inject-session-id.js",
    "converse-claude-shutdown": "./dist/claude/shutdown.js"
  },
  "pi": {
    "extensions": [
      "./pi/index.js"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-runtime-assets.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hocon-config": "^1.0.94",
    "typebox": "^1.3.6"
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "0.69.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*"
  }
}
